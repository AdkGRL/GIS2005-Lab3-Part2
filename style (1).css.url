html,
body {
  height: 100%;
  margin: 0;
  padding: 0;
}

.container {
  display: grid;
  min-height: 100vh; /* Fills the entire browser viewport */
  gap: 10px;
  grid-template-columns: 350px 1fr;
  grid-template-rows: 135px 500px 1fr 80px;
  grid-template-areas: 
    "hd hd"
    "sd-l-top main"
    "sd-l-bottom main"
    "ft ft";
}

@media (max-width: 768px) {
  .container {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    grid-template-areas:
        "hd"
        "sd-l-top"
        "sd-l-bottom"
        "main"
        "ft";
  }
}
header {
  grid-area: hd;
  padding: 10px;
}
.sidebar-l-top {
  grid-area: sd-l-top;
  background: #f4f4f4;
  padding: 10px;
  overflow-y: auto;
}

.sidebar-l-bottom {
  grid-area: sd-l-bottom;
  background: #f4f4f4;
  padding: 10px;
  overflow-y: auto;
}

main {
  grid-area: main;
  padding: 10px;
  min-width: 0;
}

arcgis-map {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 400px;
}

footer {
  grid-area: ft;
  padding: 10px;
  text-align: center;
  font-size: 12px;
}